{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "allowImportingTsExtensions": false,
        "moduleResolution": "node",
        "module": "CommonJS",
        "target": "ES2020",
        "esModuleInterop": true,
        "baseUrl": "..",
        "paths": {
            "@shared/*": [
                "./shared/*"
            ]
        }
    },
    "include": [
        ".",
        "../shared/**/*"
    ]
}