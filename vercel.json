{
    "buildCommand": "npm run vercel-build",
    "outputDirectory": "dist/public",
    "installCommand": "npm install",
    "framework": null,
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}